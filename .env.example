# 复制为 .env 填好后：set -a; source .env; set +a
# GitHub Actions 里则配置到仓库 Secrets

# 飞书群机器人 webhook（必填，路径1）
FEISHU_WEBHOOK_URL=

# Zotero API key（必填，路径2）— https://www.zotero.org/settings/keys
# 需要 library:write + file:write 权限
ZOTERO_API_KEY=
# 可选：不填则用 API key 自动解析 userID
ZOTERO_USER_ID=

# Claude 摘要（可选，不填也能跑，只是没有中文摘要和质量分）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
