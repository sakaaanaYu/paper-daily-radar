# 复制为 .env 填好后：set -a; source .env; set +a
# GitHub Actions 里则配置到仓库 Secrets

# 飞书群机器人 webhook（必填，路径1）
FEISHU_WEBHOOK_URL=

# Zotero API key（必填，路径2）— https://www.zotero.org/settings/keys
# 需要 library:write + file:write 权限
ZOTERO_API_KEY=
# 可选：不填则用 API key 自动解析 userID
ZOTERO_USER_ID=

# Notion 笔记沉淀（可选）— 不填则只写本地 notes/*.md
# 1) 到 https://www.notion.so/my-integrations 建 Internal Integration，复制 token
# 2) 在两篇笔记文档右上角 ··· → Connections → 连上这个集成
# 3) 复制各文档 URL 里那串 32 位 id
# AI / 传播分开记录，每天追加到各自文档末尾
NOTION_API_KEY=
NOTION_PAGE_ID_AI=
NOTION_PAGE_ID_COMM=

# 摘要模型（可选，不填也能跑，只是没有中文导读和质量分）
# 方式一：任意 OpenAI 兼容服务（推荐，DeepSeek/Kimi/通义/智谱/Ollama 都行）
#   服务商地址/模型名见 README
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 方式二：Claude（与方式一二选一，优先方式一）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
